{
  "info": {
    "name": "Freelance Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "access_token", "value": ""},
    {"key": "refresh_token", "value": ""},
    {"key": "job_id", "value": ""},
    {"key": "proposal_id", "value": ""},
    {"key": "contract_id", "value": ""},
    {"key": "user_id", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"client@test.com\", \"password\": \"password123\", \"full_name\": \"Ali Client\", \"role\": \"client\"}"
            }
          }
        },
        {
          "name": "Register Freelancer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"freelancer@test.com\", \"password\": \"password123\", \"full_name\": \"Mukam Freelancer\", \"role\": \"freelancer\"}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access_token);",
                  "pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"client@test.com\", \"password\": \"password123\"}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/refresh",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refresh_token}}\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/users/me",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/users/me",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"full_name\": \"Ali Updated\", \"bio\": \"Looking for great developers\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('job_id', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/jobs/",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Build a REST API\", \"description\": \"Need a FastAPI developer for a freelance platform\", \"budget\": 500}"
            }
          }
        },
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/jobs/?page=1&page_size=10",
              "query": [
                {"key": "page", "value": "1"},
                {"key": "page_size", "value": "10"},
                {"key": "status", "value": "open", "disabled": true},
                {"key": "min_budget", "value": "100", "disabled": true},
                {"key": "max_budget", "value": "1000", "disabled": true}
              ]
            },
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        },
        {
          "name": "Get Job by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/jobs/{{job_id}}",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        }
      ]
    },
    {
      "name": "Proposals",
      "item": [
        {
          "name": "Submit Proposal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('proposal_id', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/proposals/jobs/{{job_id}}/proposals",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cover_letter\": \"I have 3 years of FastAPI experience and can deliver quality work\", \"proposed_rate\": 450}"
            }
          }
        },
        {
          "name": "List Proposals",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/proposals/jobs/{{job_id}}/proposals",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        },
        {
          "name": "Accept Proposal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('contract_id', data.contract_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/proposals/{{proposal_id}}",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"accepted\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Contracts",
      "item": [
        {
          "name": "Get Contract",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/contracts/{{contract_id}}",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        },
        {
          "name": "Complete Contract",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/v1/contracts/{{contract_id}}/status",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"new_status\": \"completed\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Leave Review",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/reviews/",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"contract_id\": \"{{contract_id}}\", \"rating\": 5, \"comment\": \"Great work, very professional!\"}"
            }
          }
        },
        {
          "name": "Get User Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reviews/user/{{user_id}}",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        },
        {
          "name": "Get User Rating",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/reviews/user/{{user_id}}/rating",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}]
          }
        }
      ]
    }
  ]
}
